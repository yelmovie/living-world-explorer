  "stages": [
    {
      "id": "M1",
      "title": "균류의 흔적을 복원하라",
      "entry": "fungi-field",
      "exit": "fungi-microscope",
      "requires": [],
      "evidenceId": "E1",
      "evidenceName": "균류 관찰 패킷",
      "worldChange": "균류 표본실 조명과 관찰 안내 복구",
      "minutes": 6,
      "criteria": [
        "fungi.environment.two-types",
        "fungi.mushroom.valid-capture",
        "fungi.mold.valid-capture",
        "fungi.annotations.two-targets",
        "fungi.claim.supported"
      ],
      "interaction": {
        "requiredAdditionalCriteria": [],
        "acceptanceIds": [
          "AC-13",
          "AC-19"
        ],
        "features": [
          "baseline-capture-compare",
          "specimen-centered-zoom",
          "offset-magnifier"
        ],
        "paperLoss": "관찰 조건 변경으로 실제 시야가 달라지고 촬영 근거가 남음",
        "primary": "adjust-capture-annotate"
      }
    },
    {
      "id": "M2",
      "title": "한 방울 속 생물을 찾아라",
      "entry": "water-sampling",
      "exit": "protist-observation",
      "requires": [
        "M1"
      ],
      "evidenceId": "E2",
      "evidenceName": "원생생물 비교 기록",
      "worldChange": "수중 관찰 시설 순환 장치 복구",
      "minutes": 6,
      "criteria": [
        "water.sample.ready",
        "protist.spirogyra.capture",
        "protist.paramecium.capture",
        "protist.comparison.three-dimensions",
        "protist.motion.two-times"
      ],
      "interaction": {
        "requiredAdditionalCriteria": [
          "protist.motion.two-times"
        ],
        "acceptanceIds": [
          "AC-14",
          "AC-19"
        ],
        "features": [
          "playback-seek",
          "same-track-a-b",
          "specimen-space-trail",
          "stationary-assist"
        ],
        "paperLoss": "같은 대상의 움직임을 되돌려 보고 두 시점의 위치를 비교",
        "primary": "track-replay-compare"
      }
    },
    {
      "id": "M3",
      "title": "진짜 근거를 찾아라",
      "entry": "bacteria-sources",
      "exit": "bacteria-profile",
      "requires": [
        "M2"
      ],
      "evidenceId": "E3",
      "evidenceName": "세균 증거 프로필",
      "worldChange": "자료실 정보판 재정렬",
      "minutes": 5,
      "criteria": [
        "bacteria.sources.three-types",
        "bacteria.trait.supported",
        "bacteria.habitat.supported",
        "bacteria.claims.source-segments"
      ],
      "interaction": {
        "requiredAdditionalCriteria": [
          "bacteria.claims.source-segments"
        ],
        "acceptanceIds": [
          "AC-15",
          "AC-19"
        ],
        "features": [
          "source-segment-binding",
          "claim-support-state",
          "unlink-and-recheck"
        ],
        "paperLoss": "자료 연결을 바꾸면 주장별 근거 상태와 원문 표시가 즉시 갱신",
        "primary": "bind-review-revise"
      }
    },
    {
      "id": "M4",
      "title": "생활 속 사건을 해결하라",
      "entry": "impact-investigation",
      "exit": "impact-analysis",
      "requires": [
        "M3"
      ],
      "evidenceId": "E4",
      "evidenceName": "생활 영향 사건 보고서",
      "worldChange": "생활마을 안내와 영향 분석 오류 수정",
      "minutes": 8,
      "criteria": [
        "impact.reports.four-cases",
        "impact.evidence.two-per-case",
        "impact.fungi.context-comparison",
        "impact.bread.temporal-evidence"
      ],
      "interaction": {
        "minutesByActivity": {
          "contextComparison": 2,
          "otherCases": 3,
          "representative": 3
        },
        "features": [
          "bread-sequence-four-frames",
          "valid-temporal-pair",
          "change-annotation",
          "bread-leaf-context"
        ],
        "primary": "scrub-pin-context-compare",
        "paperLoss": "같은 표본의 시간 기록을 탐색하고 변화 전후를 고정해 근거화",
        "requiredAdditionalCriteria": [
          "impact.bread.temporal-evidence"
        ],
        "acceptanceIds": [
          "AC-16",
          "AC-19"
        ]
      }
    },
    {
      "id": "M5",
      "title": "생명과학으로 해결하라",
      "entry": "solution-assembly",
      "exit": "solution-run",
      "requires": [
        "M4"
      ],
      "evidenceId": "E5",
      "evidenceName": "BIO 솔루션 설계도",
      "worldChange": "작업실 가동 및 코어 입력 5개 준비",
      "minutes": 6,
      "criteria": [
        "solution.source.reviewed",
        "solution.graph.connected",
        "solution.biological-action.matches",
        "solution.run.passed",
        "solution.explanation.supported",
        "solution.prediction.before-run",
        "solution.reflection.supported",
        "solution.run.current-revision"
      ],
      "interaction": {
        "requiredAdditionalCriteria": [
          "solution.prediction.before-run",
          "solution.reflection.supported",
          "solution.run.current-revision"
        ],
        "acceptanceIds": [
          "AC-17",
          "AC-19"
        ],
        "features": [
          "prediction-before-run",
          "revision-bound-run",
          "run-history-compare",
          "first-success-allowed"
        ],
        "paperLoss": "자기 설계를 실행하고 예상 및 이전 실행과 결과를 비교",
        "primary": "predict-build-run-reflect"
      }
    }
  ],
